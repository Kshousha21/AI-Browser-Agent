{
  "manifest_version": 3,
  "name": "AI Browser Agent",
  "version": "0.1.0",
  "description": "Use an AI assistant on HTTP and HTTPS websites with your local backend.",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "scripting",
    "sidePanel",
    "storage",
    "downloads",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "options_page": "options/index.html",
  "action": {
    "default_title": "Open AI Browser Agent"
  }
}
