# Create backend/.env from this template only if it is missing; configure privately.
# Setup never creates or overwrites it. Never commit or print the real file.
# Run tools/init_local_config.py to create a new file with a random connection token.
# Inactive provider credentials can stay blank. Doctor checks presence only.

# Shared secret between the extension and this backend. Minimum 16 characters.
BROWSER_AUTH__TOKEN=

# Local Ollama is the shipped default; no external API key is needed.
# API credentials remain optional for explicitly selected API profiles.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=

INTERNAL_OPENAI_BASE_URL=
INTERNAL_OPENAI_API_KEY=
INTERNAL_ANTHROPIC_BASE_URL=
INTERNAL_ANTHROPIC_API_KEY=
INTERNAL_CUSTOM_BASE_URL=
INTERNAL_CUSTOM_TOKEN=

# Optional enterprise authentication and TLS references; use only in a profile
# that explicitly names them. Values and private-key contents never go in YAML.
INTERNAL_ENTERPRISE_TOKEN=
INTERNAL_EXTRA_HEADER=
PROVIDER_CA_BUNDLE_PATH=
PROVIDER_CLIENT_CERT_PATH=
PROVIDER_CLIENT_KEY_PATH=

# Optional canonical environment overrides; blank values are ignored.
BROWSER_PROVIDER__ACTIVE=

# Keep one selection: local_agent (default), local_llamacpp, anthropic, openai,
# azure_openai, internal_openai, internal_anthropic, or mock.
# Examples (uncomment only what you need; restart the backend):
# BROWSER_PROVIDER__ACTIVE=local_agent
# BROWSER_PROVIDERS__LOCAL_AGENT__MODEL=qwen3.5:9b
# BROWSER_ROUTING__ENABLED=true
# BROWSER_ROUTING__FALLBACK_PROVIDER=local_router
# BROWSER_PROVIDERS__LOCAL_AGENT__BASE_URL=http://127.0.0.1:11434
# BROWSER_PROVIDERS__LOCAL_AGENT__NUM_CTX=32768
# BROWSER_PROVIDERS__LOCAL_AGENT__THINK=false
# BROWSER_PROVIDERS__LOCAL_AGENT__TOOL_MODE=structured
# BROWSER_PROVIDERS__LOCAL_AGENT__SUPPORTS_IMAGES=true
# Text-only replacement: also set SUPPORTS_IMAGES=false.
# BROWSER_PROVIDER__ACTIVE=azure_openai
# Azure uses AZURE_OPENAI_ENDPOINT / API_KEY / DEPLOYMENT above.
# BROWSER_PROVIDER__ACTIVE=openai
# BROWSER_PROVIDERS__OPENAI__MODEL=YOUR_APPROVED_MODEL
# Ollama server settings belong in the server process, NOT this backend .env:
# OLLAMA_NO_CLOUD=1, OLLAMA_HOST=127.0.0.1:11434,
# OLLAMA_NUM_PARALLEL=1, OLLAMA_MAX_LOADED_MODELS=1.

# Optional existing Nomic adapter/base directories; never downloaded at runtime.
# BROWSER_VISUAL_RETRIEVAL__MODEL_DIRECTORY=C:/models/nomic-embed-multimodal-3b
# BROWSER_VISUAL_RETRIEVAL__BASE_MODEL_DIRECTORY=C:/models/Qwen2.5-VL-3B-Instruct
# BROWSER_VISUAL_RETRIEVAL__PYTHON_EXECUTABLE=C:/path/to/python.exe
# BROWSER_VISUAL_RETRIEVAL__DEVICE=auto
